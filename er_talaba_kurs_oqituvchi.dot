digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.3, pad=0.3, bgcolor="white"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#222222", dir=both, arrowtail=tee, arrowhead=crow, labeldistance=2.2, labelangle=25];
  "students" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#C6E0B4"><B>students</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">full_name</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(100)</TD></TR></TABLE>>];
  "teachers" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#C6E0B4"><B>teachers</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">full_name</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(100)</TD></TR></TABLE>>];
  "courses" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#C6E0B4"><B>courses</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">title</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">teacher_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER FK</TD></TR></TABLE>>];
  "enrollments" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#FCE4D6"><B>enrollments</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">student_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">course_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">grade</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER</TD></TR></TABLE>>];
  "teachers" -> "courses" [taillabel="1", headlabel="N", label="teacher_id"];
  "courses" -> "enrollments" [taillabel="1", headlabel="N", label="course_id"];
  "students" -> "enrollments" [taillabel="1", headlabel="N", label="student_id"];
}
