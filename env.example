# Ma'lumotlar bazasiga ulanish (connection string)
# Standart: SQLite (qo'shimcha o'rnatish talab qilinmaydi)
DATABASE_URL=sqlite:///shop.db

# PostgreSQL uchun (requirements.txt ichida psycopg2-binary qatorini oching):
