digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.3, pad=0.3, bgcolor="white"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#222222", dir=both, arrowtail=tee, arrowhead=crow, labeldistance=2.2, labelangle=25];
  "categories" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#C6E0B4"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">name</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(60) UQ</TD></TR></TABLE>>];
  "products" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#C6E0B4"><B>products</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">name</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">price</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">NUMERIC(10, 2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">stock</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER</TD></TR></TABLE>>];
  "users" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#C6E0B4"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">full_name</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">email</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(120) UQ</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">phone</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">created_at</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">DATETIME</TD></TR></TABLE>>];
  "orders" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#C6E0B4"><B>orders</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">user_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">status</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">created_at</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">DATETIME</TD></TR></TABLE>>];
  "product_categories" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#FCE4D6"><B>product_categories</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">product_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK,FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">category_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK,FK</TD></TR></TABLE>>];
  "order_items" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#C6E0B4"><B>order_items</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">order_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">product_id</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">quantity</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">INTEGER</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">unit_price</TD><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">NUMERIC(10, 2)</TD></TR></TABLE>>];
  "users" -> "orders" [taillabel="1", headlabel="N", label="user_id"];
  "products" -> "product_categories" [taillabel="1", headlabel="N", label="product_id"];
  "categories" -> "product_categories" [taillabel="1", headlabel="N", label="category_id"];
  "products" -> "order_items" [taillabel="1", headlabel="N", label="product_id"];
  "orders" -> "order_items" [taillabel="1", headlabel="N", label="order_id"];
}
